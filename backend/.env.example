PORT=5100
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/employeeos

JWT_ACCESS_SECRET=your-super-secret-access-token-key
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Set to true to create a default SUPER_ADMIN account on startup (dev only —
# only ever creates the account once; an existing account's password is never
# touched by this on subsequent restarts)
SEED_ADMIN=false
SEED_ADMIN_EMAIL=admin@employeeos.io
SEED_ADMIN_PASSWORD=Password123
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# Document management (Step 8)
STORAGE_PROVIDER=local
DOCUMENT_STORAGE_ROOT=
MAX_UPLOAD_SIZE_MB=25
DOCUMENT_DEFAULT_MAX_FILE_SIZE_MB=10
DOCUMENT_EXPIRY_WARNING_DAYS=30
DOCUMENT_EXPIRY_CRON_SCHEDULE=0 2 * * *
CRON_TIMEZONE=UTC

# Onboarding pre-boarding (Step 10B-1)
AVATAR_MAX_SIZE_MB=5

# Asset management (Step 10C)
ASSET_WARRANTY_WARNING_DAYS=30

# Recruitment (Step 9)
OFFER_TOKEN_TTL_DAYS=14
RESUME_MAX_SIZE_MB=10
RESUME_ALLOWED_EXTENSIONS=pdf,doc,docx

# Outbound email (generic SMTP — works with Gmail, SES, SendGrid SMTP relay, Resend, etc.)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
