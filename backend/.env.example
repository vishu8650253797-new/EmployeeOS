PORT=5100
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/employeeos

JWT_ACCESS_SECRET=your-super-secret-access-token-key
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Set to true to create a default SUPER_ADMIN account on startup (dev only)
SEED_ADMIN=false
SEED_ADMIN_EMAIL=admin@employeeos.io
SEED_ADMIN_PASSWORD=Password123

# Document management (Step 8)
STORAGE_PROVIDER=local
DOCUMENT_STORAGE_ROOT=
MAX_UPLOAD_SIZE_MB=25
DOCUMENT_DEFAULT_MAX_FILE_SIZE_MB=10
DOCUMENT_EXPIRY_WARNING_DAYS=30
DOCUMENT_EXPIRY_CRON_SCHEDULE=0 2 * * *
CRON_TIMEZONE=UTC
